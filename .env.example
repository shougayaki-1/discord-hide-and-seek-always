# このファイルを .env にコピーして、値を実際のものに書き換えてください。
#   cp .env.example .env
# .env はコミットしないでください（.gitignore で除外済みです）。

# 必須: Discord Developer Portal の「Bot」タブで取得したBotトークン
DISCORD_TOKEN=

# 必須: Discord Developer Portal の「General Information」にある APPLICATION ID
DISCORD_CLIENT_ID=

# 任意: ヘルスチェック用HTTPサーバのポート（未指定なら 8000）
PORT=8000
